# Uploader environment template.
#
# Copy this file to a runtime location (e.g. /etc/ros2-recorder/uploader.env)
# on each robot, fill in the placeholders, and load via systemd/cron.
#
# Shared values are identical across all robots — set them once.
# Per-robot values (BRANCH_ID, BRANCH_NAME) differ per deployment site.

# ========== Shared (same for every robot) ==========

# Path to the company Service Account JSON key (NOT committed; distribute via secure channel).
GOOGLE_APPLICATION_CREDENTIALS=/etc/ros2-recorder/keys/company-sa.json

# Shared Drive ID of the company drive (e.g. "[XYZ] 본사 자료").
# Grab from URL: https://drive.google.com/drive/folders/<ID>
UPLOAD_SHARED_DRIVE_ID=<REPLACE_WITH_SHARED_DRIVE_ID>

# Upload root folder ID (a dedicated sub-folder inside the Shared Drive).
# The uploader will auto-create "barisbrew-recorded-datas/<branch>/..." under this.
UPLOAD_ROOT_ID=<REPLACE_WITH_ROOT_FOLDER_ID>

# ========== Per-robot (edit on each robot) ==========

# Branch code — matches the --branch-id passed to camera_recorder.py.
BRANCH_ID=BB003

# Branch display name — used in the Drive folder name "{BRANCH_ID}({BRANCH_NAME})".
BRANCH_NAME=성수본점
