# Recorder + uploader environment template.
#
# Copy this file to /etc/ros2-recorder/recorder.env on each robot,
# fill in the placeholders, and it will be loaded by both systemd (recorder)
# and cron (deliver.sh).
#
# Shared values are identical across all robots — set them once.
# Per-robot values (BRANCH_ID, BRANCH_NAME) differ per deployment site.

# ========== Shared (same for every robot of the same fleet) ==========

# Path to the company Service Account JSON key (NOT committed; distribute via secure channel).
GOOGLE_APPLICATION_CREDENTIALS=/etc/ros2-recorder/keys/company-sa.json

# Shared Drive ID (e.g. company "[XYZ] 본사 자료" root).
# From URL: https://drive.google.com/drive/folders/<ID>
UPLOAD_SHARED_DRIVE_ID=<REPLACE_WITH_SHARED_DRIVE_ID>

# Upload root folder ID. Two environments are expected:
#   Prod: a top-level folder named `robot-data-archive` in the Shared Drive root.
#   Dev:  a folder named `robot-data-archive-dev` under the team folder (`로봇지능화팀/`).
# The uploader writes directly under this ID — it does NOT create `robot-data-archive/`
# for you. The first folder it creates is `{PRODUCT}/`.
UPLOAD_ROOT_ID=<REPLACE_WITH_ROOT_FOLDER_ID>

# Robot product codename: `barisbrew` (cafe), `storagy` (AMR), `deux` (humanoid).
PRODUCT=barisbrew

# ========== Per-robot (edit on each robot) ==========

# Branch code — matches the --branch-id passed to camera_recorder.py.
BRANCH_ID=BB003

# Branch display name — used in the Drive folder name "{BRANCH_ID}({BRANCH_NAME})".
BRANCH_NAME=성수본점

# ========== Recorder (systemd) ==========

# ROS2 domain ID — must match the robot's ROS2 network.
ROS_DOMAIN_ID=22

# ROS2 image topic to record.
TOPIC=/camera/color/image_raw

# Recording FPS.
FPS=30

# Segment duration override in seconds. Leave empty for wall-clock aligned
# hourly segments (split at every :00). Only set for fixed-duration testing.
# SEGMENT=3600

# Video label used in output filenames.
VIDEO_LABEL=topview_video

# CRF quality (lower = higher quality, higher bitrate). Recommended: 28 for ops.
CRF=28

# Max bitrate cap (e.g. 2M). Suppresses night-time bitrate spikes.
# Leave empty to disable.
MAXRATE=2M

# ========== Upload (cron — deliver.sh) ==========

# Directory where completed segments are stored.
# Defaults to ./videos in dev; production deployments should set an absolute path.
VIDEOS_DIR=/var/lib/ros2-recorder/videos
